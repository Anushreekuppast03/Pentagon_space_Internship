package com.in.doubl;

class Node {
    int data;
    Node next;
    Node prev;

    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }
}

class DLinkedList {
    Node head;
    Node tail;

    // Add node at the end
    public void add_last(int data) {
        Node temp = new Node(data);
        if (head == null) {
            head = tail = temp;
        } else {
            tail.next = temp;
            temp.prev = tail;
            tail = temp;
        }
    }

    // Add node at the beginning
    public void add_first(int data) {
        Node temp = new Node(data);
        if (head == null) {
            head = tail = temp;
        } else {
            temp.next = head;
            head.prev = temp;
            head = temp;
        }
    }

    // Print list forward
    public void print_LL() {
        Node curr = head;
        while (curr != null) {
            System.out.print(curr.data + " ");
            curr = curr.next;
        }
        System.out.println();
    }

    // Print list backward
    public void print_LLR() {
        Node curr = tail;
        while (curr != null) {
            System.out.print(curr.data + " ");
            curr = curr.prev;
        }
        System.out.println();
    }

    public void add_index(int data,int index) {
    	if(index<0||index>size()) {
    		System.out.println(" ");
    		return;
    	}if(index==0) {
    		add_first(data);
    	}else if (index==size()){
    		add_last(data);
    	}
    	
    	else {
    		Node curr=head;
    		Node temp=new Node(data);
    		for(int i=0;i<index-1;i++) {
    			curr=curr.next;
    			
    		}
    		Node n_node=curr.next;
    		temp.next=n_node;
    		temp.prev=curr;
    		curr.next=temp;
    		n_node.prev=temp;
    	}
    }
    
    //sizee
    public int size() {
        int count = 0;
        Node curr = head;
        while (curr != null) {
            count++;
            curr = curr.next;
        }
        return count;
    }
    
    // Delete first node
    public void deleteFirst() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        if (head.next == tail) { // only one node
            head = tail = null;
        } else {
            head = head.next;
            head.prev = null;
        }
    }

    // Delete last node
    public void deleteLast() {
        if (tail == null) {
            System.out.println("List is empty");
            return;
        }

        if (tail.prev ==null) { // only one node
            head = tail = null;
        } else {
            tail = tail.prev;
            tail.next = null;
        }
    }
}

public class Doublelist {
    public static void main(String[] args) {
        DLinkedList dll = new DLinkedList();

        dll.add_last(10);//10
        dll.add_last(20);//10 20
        dll.add_last(30);//10 20 30
        dll.print_LL();   // 10 20 30

        dll.add_first(5);//5 10m20m 30
        dll.print_LLR();  // 30 20 10 5
        dll.print_LL();   // 5 10 20 30

        dll.add_index(15, 2);//5 10 15 20 30
        dll.print_LL(); 
        dll.print_LLR(); //30 20 15 10 5
        
        dll.deleteFirst();//10 15 20 30
        dll.print_LL();   // 10 20 30

       
        
        dll.deleteLast();
        dll.print_LL(); 
        // 10 20
        
       
    }
}

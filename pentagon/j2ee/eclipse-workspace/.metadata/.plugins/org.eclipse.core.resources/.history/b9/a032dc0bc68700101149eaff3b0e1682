package com.in.doubl;

class Node {
    int data;
    Node next;
    Node prev;

    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }
}

class DLinkedList {
    Node head;
    Node tail;

    // Add node at the end
    public void add_last(int data) {
        Node temp = new Node(data);
        if (head == null) {
            head = tail = temp;
        } else {
            tail.next = temp;
            temp.prev = tail;
            tail = temp;
        }
    }

    // Add node at the beginning
    public void add_first(int data) {
        Node temp = new Node(data);
        if (head == null) {
            head = tail = temp;
        } else {
            temp.next = head;
            head.prev = temp;
            head = temp;
        }
    }

    // Print list forward
    public void print_LL() {
        Node curr = head;
        while (curr != null) {
            System.out.print(curr.data + " ");
            curr = curr.next;
        }
        System.out.println();
    }

    // Print list backward
    public void print_LLR() {
        Node curr = tail;
        while (curr != null) {
            System.out.print(curr.data + " ");
            curr = curr.prev;
        }
        System.out.println();
    }

    // Delete first node
    public void deleteFirst() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        if (head == tail) { // only one node
            head = tail = null;
        } else {
            head = head.next;
            head.prev = null;
        }
    }

    // Delete last node
    public void deleteLast() {
        if (tail == null) {
            System.out.println("List is empty");
            return;
        }

        if (tail.prev ==null) { // only one node
            head = tail = null;
        } else {
            tail = tail.prev;
            tail.next = null;
        }
    }
}

public class Doublelist {
    public static void main(String[] args) {
        DLinkedList dll = new DLinkedList();

        dll.add_last(10);
        dll.add_last(20);
        dll.add_last(30);
        dll.print_LL();   // 10 20 30

        dll.add_first(5);
        dll.print_LLR();  // 30 20 10 5
        dll.print_LL();   // 5 10 20 30

        dll.deleteFirst();
        dll.print_LL();   // 10 20 30

        dll.deleteLast();
        dll.print_LL();   // 10 20
    }
}
